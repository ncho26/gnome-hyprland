#!/usr/bin/env sh
set -eu

logout() {
  if command -v uwsm >/dev/null 2>&1 && uwsm check is-active >/dev/null 2>&1; then
    exec uwsm stop
  fi

  uid=$(id -u)
  : "${XDG_RUNTIME_DIR:=/run/user/$uid}"
  export XDG_RUNTIME_DIR

  if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    HYPRLAND_INSTANCE_SIGNATURE=$(
      hyprctl instances 2>/dev/null |
        awk '/^instance / { sub(/:$/, "", $2); print $2; exit }'
    )
    export HYPRLAND_INSTANCE_SIGNATURE
  fi

  if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    printf 'wayland-exit-menu: could not determine HYPRLAND_INSTANCE_SIGNATURE\n' >&2
    exit 1
  fi

  exec hyprctl dispatch exit
}

if [ "${1:-}" = "--logout" ]; then
  logout
fi

choice=$(
  printf '%s\n' "Logout" "Restart" "Shutdown" "Cancel" |
    rofi -dmenu -i -no-custom -p "Power"
) || exit 0

case "$choice" in
  Logout)
    logout
    ;;
  Restart)
    systemctl reboot
    ;;
  Shutdown)
    systemctl poweroff
    ;;
  *)
    exit 0
    ;;
esac
